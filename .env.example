# DocRAG Environment Configuration (Placeholders only)

# Application
PROJECT_NAME=DocRAG
ENVIRONMENT=development
DEBUG=True

# Security & Authentication
# Generate a secure key in production with: openssl rand -hex 32
SECRET_KEY=your-super-secret-key-change-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=120
REFRESH_TOKEN_EXPIRE_DAYS=14

# Google OAuth (Optional)
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_REDIRECT_URI=http://localhost:3000/auth/callback

# Database (Supabase PostgreSQL with pgvector or Local PostgreSQL)
# For Supabase: postgresql+asyncpg://postgres:[YOUR-PASSWORD]@db.[PROJECT-REF].supabase.co:5432/postgres
# For Local Docker: postgresql+asyncpg://postgres:postgres@localhost:5432/docrag
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/docrag

# Redis & Celery
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0

# LLM Generation (Groq Free Tier)
LLM_PROVIDER=groq
GROQ_API_KEY=gsk_your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile

# Alternative LLM: Google Gemini
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-1.5-flash
GEMINI_EMBEDDING_MODEL=text-embedding-004

# Embeddings (Free-tier-first local embedding or Gemini)
# Options: 'local' (Free FastEmbed / BAAI/bge-small-en-v1.5) or 'gemini'
EMBEDDING_PROVIDER=local
LOCAL_EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
VECTOR_DIMENSION=384

# File Storage
# Options: 'local' (Development) or 'supabase' (Supabase Storage Free Tier) or 's3'
STORAGE_TYPE=local
LOCAL_STORAGE_DIR=backend/uploads
MAX_FILE_SIZE_MB=25

# Supabase Storage Configuration (if STORAGE_TYPE=supabase)
SUPABASE_URL=https://[PROJECT-REF].supabase.co
SUPABASE_KEY=your-supabase-service-role-or-anon-key
SUPABASE_BUCKET=documents
